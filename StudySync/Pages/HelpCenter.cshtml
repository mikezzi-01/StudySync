        <span>AI Matching</span>
    </a>
    <a href="#partnerships" class="hc-quicknav-item">
        <i class="fa-solid fa-handshake"></i>
        <span>Partnerships</span>
    </a>
    <a href="#collaborate" class="hc-quicknav-item">
        <i class="fa-solid fa-users"></i>
