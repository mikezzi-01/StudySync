    <div>
        <h1><i class="fa-solid fa-circle-question"></i> Help Center</h1>
        <p>Everything you need to know about using StudySync effectively.</p>
    </div>
</div>

<!-- Quick navigation -->
<div class="hc-quicknav">
    <a href="#getting-started" class="hc-quicknav-item">
        <i class="fa-solid fa-rocket"></i>
        <span>Getting Started</span>
    </a>
    <a href="#ai-matching" class="hc-quicknav-item">
