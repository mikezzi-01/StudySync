@page
@model StudySync.Pages.ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>StudySync — Reset Password</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/auth.css" />
    <link rel="stylesheet" href="~/css/forgotpassword.css" />
</head>
<body>

    <div class="fp-wrapper">
        <div class="fp-card">

            <div class="fp-brand">
                <i class="fa-solid fa-book-open"></i> StudySync
            </div>

            @if (Model.ResetSuccess)
            {
                <!-- Success state -->
                <div class="fp-success">
                    <div class="fp-success-icon" style="background:#e8fdf5; color:#1abc9c;">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <h2>Password Reset Successful!</h2>
                    <p>
                        Your password has been updated successfully.
                        You can now sign in with your new password.
                    </p>
                    <a href="/Login" class="btn-primary">
                        <i class="fa-solid fa-right-to-bracket"></i> Sign In
                    </a>
                </div>
            }
            else
            {
                <div class="fp-icon">
                    <i class="fa-solid fa-key"></i>
                </div>
                <h2>Reset Your Password</h2>
                <p class="fp-subtitle">
                    Enter your reset token and choose a new password.
                </p>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-error">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        @Model.ErrorMessage
                    </div>
                }

                <form method="post">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label>EMAIL ADDRESS</label>
                        <div class="input-icon-wrapper">
                            <i class="fa-solid fa-envelope input-icon"></i>
                            <input asp-for="Input.Email"
                                   type="email"
                                   placeholder="youremail@gmail.com" />
                        </div>
                        <span asp-validation-for="Input.Email" class="field-error"></span>
                    </div>

                    <div class="form-group">
                        <label>RESET TOKEN</label>
                        <div class="input-icon-wrapper">
                            <i class="fa-solid fa-key input-icon"></i>
                            <input asp-for="Input.Token"
                                   placeholder="e.g. AB3X7YKP"
                                   style="text-transform: uppercase; letter-spacing: 0.15em;" />
                        </div>
                        <span asp-validation-for="Input.Token" class="field-error"></span>
                        <small class="field-hint">
                            Enter the token shown on the previous page.
                        </small>
                    </div>

                    <div class="form-group">
                        <label>NEW PASSWORD</label>
                        <div class="password-wrapper">
                            <input asp-for="Input.NewPassword"
                                   type="password"
                                   id="newPasswordInput"
                                   placeholder="••••••••" />
                            <button type="button" class="toggle-password"
                                    onclick="togglePwd('newPasswordInput')">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                        </div>
                        <div class="password-strength" id="strengthBar"></div>
                        <small id="strengthLabel" class="strength-label"></small>
                        <span asp-validation-for="Input.NewPassword" class="field-error"></span>
                    </div>

                    <div class="form-group">
                        <label>CONFIRM NEW PASSWORD</label>
                        <div class="password-wrapper">
                            <input asp-for="Input.ConfirmPassword"
                                   type="password"
                                   id="confirmPasswordInput"
                                   placeholder="••••••••" />
                            <button type="button" class="toggle-password"
                                    onclick="togglePwd('confirmPasswordInput')">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
                    </div>

                    <button type="submit" class="btn-primary">
                        <i class="fa-solid fa-lock"></i> Reset Password
                    </button>

                    <a href="/Login" class="fp-back-link">
                        <i class="fa-solid fa-arrow-left"></i> Back to Login
                    </a>
                </form>
            }

        </div>
    </div>

    <script>
            function togglePwd(id) {
                const input = document.getElementById(id);
                input.type = input.type === 'password' ? 'text' : 'password';
            }

            document.getElementById('newPasswordInput')?.addEventListener('input', function () {
                const val = this.value;
                const bar   = document.getElementById('strengthBar');
                const label = document.getElementById('strengthLabel');
                let strength = 0;
                if (val.length >= 8)          strength++;
                if (/[A-Z]/.test(val))        strength++;
                if (/[0-9]/.test(val))        strength++;
                if (/[^A-Za-z0-9]/.test(val)) strength++;

                const levels = ['', 'Weak', 'Fair', 'Good', 'Strong'];
                const colors = ['', '#e74c3c', '#e67e22', '#f1c40f', '#2ecc71'];
                bar.style.width      = (strength * 25) + '%';
                bar.style.background = colors[strength];
                label.textContent    = strength > 0 ? levels[strength] : '';
            });
    </script>

</body>
</html>
