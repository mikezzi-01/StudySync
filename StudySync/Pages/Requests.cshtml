@page
@model StudySync.Pages.RequestsModel
@{
    ViewData["Title"] = "Partnership Requests";
}

<!-- Anti-forgery token for JS fetch calls -->
@Html.AntiForgeryToken()

@section Styles {
    <link rel="stylesheet" href="~/css/requests.css" />
}

<!-- Success / error messages -->
@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">
        <i class="fas fa-circle-check"></i> @Model.SuccessMessage
    </div>
}

<!-- ── TABS ── -->
<div class="tabs">
    <button class="tab active" onclick="switchTab('incoming', this)">
        Incoming
        @if (Model.IncomingRequests.Count > 0)
        {
            <span class="tab-count">@Model.IncomingRequests.Count</span>
        }
    </button>
    <button class="tab" onclick="switchTab('sent', this)">
        Sent
        @if (Model.SentRequests.Count > 0)
        {
            <span class="tab-count">@Model.SentRequests.Count</span>
        }
    </button>
    <button class="tab" onclick="switchTab('active', this)">
        Active
        @if (Model.ActivePartnerships.Count > 0)
        {
            <span class="tab-count">@Model.ActivePartnerships.Count</span>
        }
    </button>
</div>

<!-- ── INCOMING REQUESTS ── -->
<div id="tab-incoming" class="tab-panel">
    @if (Model.IncomingRequests.Count == 0)
    {
        <div class="empty-state">
            <i class="fas fa-inbox empty-icon"></i>
            <p>No incoming requests at the moment.</p>
            <span>When someone sends you a study request it will appear here.</span>
        </div>
    }
    else
    {
        foreach (var req in Model.IncomingRequests)
        {
            <div class="request-card" id="card-@req.PartnershipId" data-name="@req.FullName.ToLower()">
                <div class="request-avatar">@req.Initials</div>
                <div class="request-info">
                    <div class="request-name">@req.FullName</div>
                    <div class="request-meta">
                        <span><i class="fas fa-graduation-cap"></i> @req.AcademicLevel Level</span>
                        <span><i class="fas fa-clock"></i> @req.TimeAgo</span>
                    </div>
                    <div class="request-tags">
                        @foreach (var tag in req.InterestTags.Take(4))
                        {
                            <span class="tag">@tag</span>
                        }
                    </div>
                </div>
                <div class="request-score">
                    <div class="score-badge @(req.MatchScore >= 70 ? "score-green" : "score-blue")">
                        @req.MatchScore%
                    </div>
                    <div class="score-label">MATCH</div>
                </div>
                <div class="request-actions">
                    <button class="btn-accept"
                            onclick="respondToRequest(@req.PartnershipId, 'accept', this)">
                        <i class="fas fa-check"></i> Accept
                    </button>
                    <button class="btn-decline"
                            onclick="respondToRequest(@req.PartnershipId, 'decline', this)">
                        <i class="fas fa-xmark"></i> Decline
                    </button>
                </div>
            </div>
        }
    }
</div>

<!-- ── SENT REQUESTS ── -->
<div id="tab-sent" class="tab-panel hidden">
    @if (Model.SentRequests.Count == 0)
    {
        <div class="empty-state">
            <i class="fas fa-paper-plane empty-icon"></i>
            <p>No sent requests yet.</p>
            <span>Visit <a href="/Matches">AI Matches</a> to send study requests.</span>
        </div>
    }
    else
    {
        foreach (var req in Model.SentRequests)
        {
            <div class="request-card" data-name="@req.FullName.ToLower()">
                <div class="request-avatar">@req.Initials</div>
                <div class="request-info">
                    <div class="request-name">@req.FullName</div>
                    <div class="request-meta">
                        <span><i class="fas fa-graduation-cap"></i> @req.AcademicLevel Level</span>
                        <span><i class="fas fa-clock"></i> @req.TimeAgo</span>
                    </div>
                    <div class="request-tags">
                        @foreach (var tag in req.InterestTags.Take(4))
                        {
                            <span class="tag">@tag</span>
                        }
                    </div>
                </div>
                <div class="request-score">
                    <div class="score-badge @(req.MatchScore >= 70 ? "score-green" : "score-blue")">
                        @req.MatchScore%
                    </div>
                    <div class="score-label">MATCH</div>
                </div>
                <div class="request-status">
                    <span class="status-pill status-pending">
                        <i class="fas fa-hourglass-half"></i> Pending
                    </span>
                </div>
            </div>
        }
    }
</div>

<!-- ── ACTIVE PARTNERSHIPS ── -->
<div id="tab-active" class="tab-panel hidden">
    @if (Model.ActivePartnerships.Count == 0)
    {
        <div class="empty-state">
            <i class="fas fa-users empty-icon"></i>
            <p>No active partnerships yet.</p>
            <span>Accept an incoming request to start collaborating.</span>
        </div>
    }
    else
    {
        foreach (var partner in Model.ActivePartnerships)
        {
            <div class="request-card" data-name="@partner.FullName.ToLower()">
                <div class="request-avatar">@partner.Initials</div>
                <div class="request-info">
                    <div class="request-name">@partner.FullName</div>
                    <div class="request-meta">
                        <span><i class="fas fa-graduation-cap"></i> @partner.AcademicLevel Level</span>
                        <span><i class="fas fa-calendar-check"></i> Since @partner.TimeAgo</span>
                    </div>
                    <div class="request-tags">
                        @foreach (var tag in partner.InterestTags.Take(4))
                        {
                            <span class="tag">@tag</span>
                        }
                    </div>
                </div>
                <div class="request-score">
                    <div class="score-badge score-green">@partner.MatchScore%</div>
                    <div class="score-label">MATCH</div>
                </div>
                <div class="request-actions">
                    <a href="/Collaborate/@partner.PartnershipId"
                        class="btn-collaborate">
                        <i class="fas fa-comments"></i> Collaborate
                    </a>
                </div>
            </div>
        }
    }
</div>


    <script>
        // ── Navigation toggle ────────────────────────────────────────────────
        const navToggle = document.getElementById('navToggle');
        const sidebar = document.querySelector('.sidebar');

        if (navToggle) {
            navToggle.addEventListener('click', () => {
                sidebar.classList.toggle('active');
                navToggle.classList.toggle('active');
            });

            // Close sidebar when a link is clicked
            const navItems = document.querySelectorAll('.sidebar .nav-item, .sidebar .nav-item-sm, .sidebar .btn-start-session');
            navItems.forEach(item => {
                item.addEventListener('click', () => {
                    sidebar.classList.remove('active');
                    navToggle.classList.remove('active');
                });
            });

            // Close sidebar when clicking outside
            document.addEventListener('click', (e) => {
                if (!sidebar.contains(e.target) && !navToggle.contains(e.target)) {
                    sidebar.classList.remove('active');
                    navToggle.classList.remove('active');
                }
            });
        }

        // ── Tab switching ─────────────────────────────────────────────────────
        function switchTab(name, btn) {
            document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            document.getElementById('tab-' + name).classList.remove('hidden');
            btn.classList.add('active');
        }

        // ── Filter requests ───────────────────────────────────────────────────
        function filterRequests() {
            const q = document.getElementById('requestSearch').value.toLowerCase();
            document.querySelectorAll('.request-card').forEach(card => {
                const name = card.dataset.name || '';
                card.style.display = name.includes(q) ? '' : 'none';
            });
        }

        // ── Accept / Decline request ──────────────────────────────────────────
        async function respondToRequest(partnershipId, action, btn) {
            btn.disabled = true;
            const token  = document.querySelector('input[name="__RequestVerificationToken"]').value;

            const response = await fetch('/Requests?handler=Respond', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ partnershipId, action })
            });

            if (response.ok) {
                const card = document.getElementById('card-' + partnershipId);
                if (action === 'accept') {
                    card.classList.add('card-accepted');
                    card.querySelector('.request-actions').innerHTML =
                        '<span class="status-pill status-active"><i class="fas fa-check-circle"></i> Accepted — Go to <a href="/Collaborate/' + partnershipId + '">Collaborate</a></span>';
                } else {
                    card.classList.add('card-declined');
                    card.querySelector('.request-actions').innerHTML =
                        '<span class="status-pill status-declined"><i class="fas fa-xmark-circle"></i> Declined</span>';
                }
            } else {
                btn.disabled = false;
                alert('Something went wrong. Please try again.');
            }
        }

        function handleSearch(query) {
            const q = query.toLowerCase();
            document.querySelectorAll('.request-card').forEach(card => {
                const name = card.querySelector('.request-name')?.textContent.toLowerCase() || '';
                card.style.display = name.includes(q) ? '' : 'none';
            });
        }
    </script>

