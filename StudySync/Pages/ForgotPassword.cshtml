@page
@model StudySync.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>StudySync — Forgot Password</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <link rel="stylesheet" href="~/css/auth.css" />
    <link rel="stylesheet" href="~/css/forgotpassword.css" />
</head>
<body>

    <div class="fp-wrapper">
        <div class="fp-card">

            <div class="fp-brand">
                <i class="fa-solid fa-book-open"></i> StudySync
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-error">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    @Model.ErrorMessage
                </div>
            }

            @if (Model.EmailSent)
            {
                <div class="fp-success">
                    <div class="fp-success-icon">
                        <i class="fa-solid fa-envelope-circle-check"></i>
                    </div>
                    <h2>Check Your Email</h2>
                    <p>
                        If an account exists for <strong>@Model.SubmittedEmail</strong>,
                        a password reset token has been sent to that email address.
                    </p>
                    <p class="fp-token-instruction">
                        Please check your inbox (and spam folder) for an email
                        from StudySync. The token expires in <strong>30 minutes</strong>.
                    </p>
                    <a href="/ResetPassword" class="btn-primary">
                        <i class="fa-solid fa-lock"></i> Reset My Password
                    </a>
                    <a href="/Login" class="fp-back-link">
                        <i class="fa-solid fa-arrow-left"></i> Back to Login
                    </a>
                </div>
            }
            else
            {
                <!-- Form state -->
                <div class="fp-icon">
                    <i class="fa-solid fa-lock"></i>
                </div>
                <h2>Forgot Password?</h2>
                <p class="fp-subtitle">
                    Enter your registered email address and we will generate
                    a reset token for you.
                </p>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-error">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        @Model.ErrorMessage
                    </div>
                }

                <form method="post">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label>EMAIL ADDRESS</label>
                        <div class="input-icon-wrapper">
                            <i class="fa-solid fa-envelope input-icon"></i>
                            <input asp-for="Input.Email"
                                   type="email"
                                   placeholder="youremail@gmail.com" />
                        </div>
                        <span asp-validation-for="Input.Email" class="field-error"></span>
                    </div>

                    <button type="submit" class="btn-primary">
                        <i class="fa-solid fa-paper-plane"></i> Generate Reset Token
                    </button>

                    <a href="/Login" class="fp-back-link">
                        Back to Login
                    </a>
                </form>
            }

        </div>
    </div>

</body>
</html>

