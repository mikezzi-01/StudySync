@page
@model StudySync.Pages.CollaborateHomeModel
@{
    ViewData["Title"] = "Collaborate";
}

@section Styles {
    <link rel="stylesheet" href="~/css/collaboratehome.css" asp-append-version="true" />
}

<!-- Page heading -->
<div class="ch-heading">
    <div>
        <h1><i class="fa-solid fa-users"></i> Collaborate</h1>
        <p>Your active study partnerships and workspaces.</p>
    </div>
    <a href="/Matches" class="btn-find-partner">
        <i class="fa-solid fa-plus"></i> Find New Partner
    </a>
</div>

<!-- ── Active partnerships ── -->
@if (Model.ActivePartnerships.Count == 0)
{
    <div class="empty-collab">
        <i class="fa-solid fa-users-slash"></i>
        <h2>No Active Collaborations Yet</h2>
        <p>Once a study partner accepts your request, your workspace will appear here.</p>
        <a href="/Matches" class="btn-primary">
            <i class="fa-solid fa-brain"></i> Browse AI Matches
        </a>
    </div>
}
else
{
    <div class="collab-grid">
        @foreach (var collab in Model.ActivePartnerships)
        {
            <div class="collab-card">
                <div class="collab-card-header">
                    <div class="collab-av">@collab.Initials</div>
                    <div class="collab-card-info">
                        <div class="collab-card-name">@collab.FullName</div>
                        <div class="collab-card-level">
                            <i class="fa-solid fa-graduation-cap"></i>
                            @collab.AcademicLevel Level
                        </div>
                    </div>
                    <div class="collab-score @(collab.MatchScore >= 70 ? "score-green" : "score-blue")">
                        @collab.MatchScore%
                    </div>
                </div>

                <div class="collab-card-tags">
                    @foreach (var tag in collab.InterestTags.Take(3))
                    {
                        <span class="tag">@tag</span>
                    }
                </div>

                <div class="collab-card-meta">
                    <span>
                        <i class="fa-solid fa-calendar-check"></i>
                        Partner since @collab.PartnerSince
                    </span>
                    <span class="status-active">
                        <i class="fa-solid fa-circle"></i> Active
                    </span>
                </div>

                <div class="collab-card-actions">
                    <a href="/Collaborate/@collab.PartnershipId"
                        class="btn-open-workspace">
                        <i class="fa-solid fa-comments"></i> Open Workspace
                    </a>
                    <a href="/Feedback/@collab.PartnershipId"
                        class="btn-feedback">
                        <i class="fa-solid fa-star"></i>
                    </a>
                </div>
            </div>
        }
    </div>
}

<!-- ── Ended partnerships ── -->
@if (Model.EndedPartnerships.Count > 0)
{
    <div class="section-divider">
        <h2>Past Collaborations</h2>
    </div>

    <div class="collab-grid">
        @foreach (var collab in Model.EndedPartnerships)
        {
            <div class="collab-card ended-card">
                <div class="collab-card-header">
                    <div class="collab-av av-grey">@collab.Initials</div>
                    <div class="collab-card-info">
                        <div class="collab-card-name">@collab.FullName</div>
                        <div class="collab-card-level">
                            <i class="fa-solid fa-graduation-cap"></i>
                            @collab.AcademicLevel Level
                        </div>
                    </div>
                </div>

                <div class="collab-card-meta">
                    <span>
                        <i class="fa-solid fa-calendar-xmark"></i>
                        Ended @collab.PartnerSince
                    </span>
                    <span class="status-ended">
                        <i class="fa-solid fa-circle"></i> Ended
                    </span>
                </div>

                <div class="collab-card-actions">
                    <a href="/Feedback/@collab.PartnershipId"
                        class="btn-open-workspace">
                        <i class="fa-solid fa-star"></i> Leave Feedback
                    </a>
                </div>
            </div>
        }
    </div>
}

<script>
    function handleSearch(query) {
        const q = query.toLowerCase();
        document.querySelectorAll('.collab-card').forEach(card => {
            const name = card.querySelector('.collab-card-name')?.textContent.toLowerCase() || '';
            card.style.display = name.includes(q) ? '' : 'none';
        });
    }
</script>
