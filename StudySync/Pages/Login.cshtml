@page
@model StudySync.Pages.LoginModel
@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>StudySync — Sign In</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>

    <div class="auth-container">

        <!-- Left branding panel -->
        <div class="auth-brand">
            
            <div class="brand-logo">
                <span class="logo-icon"><i class="fa-solid fa-book-open"></i></span> STUDYSYNC
            </div>
            <h1>Welcome<br />Back!</h1>
            <p>Rejoin your study clusters, pick up your last flashcard deck, and continue your journey toward mastery.</p>
            
        </div>

        <!-- Right form panel -->
        <div class="auth-form-panel login-panel">
            <h2>Sign in to StudySync</h2>
            <p class="form-subtitle">
                Don't have an account? <a href="/Register">Register here</a>
            </p>

            <!-- Error toast -->
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-error">
                    <span>&#9888;</span> @Model.ErrorMessage
                    <button type="button" onclick="this.parentElement.style.display='none'">&#10005;</button>
                </div>
            }

            <form method="post">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label asp-for="Input.EmailOrMatric">EMAIL OR MATRIC NUMBER</label>
                    <div class="input-icon-wrapper">
                       
                        <input asp-for="Input.EmailOrMatric"
                               placeholder="e.g. FOC/22/000001 or youremail@gmail.com" />
                    </div>
                    <span asp-validation-for="Input.EmailOrMatric" class="field-error"></span>
                </div>

                <div class="form-group">
                    <div class="label-row">
                        <label asp-for="Input.Password">PASSWORD</label>
                        <a href="/ForgotPassword" class="forgot-link">FORGOT PASSWORD?</a>
                    </div>
                    <div class="password-wrapper">
                        <i class="fas fa-lock input-icon"></i>
                        <input asp-for="Input.Password" type="password"
                               id="loginPassword" placeholder="********" />
                        <button type="button" class="toggle-password"
                                onclick="togglePassword('loginPassword', this)">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="field-error"></span>
                </div>

                <div class="form-group form-check">
                    <input asp-for="Input.RememberMe" type="checkbox" id="rememberCheck" />
                    <label for="rememberCheck">Remember this session</label>
                </div>

                <button type="submit" class="btn-primary">Sign In</button>

                
            </form>

            <p class="copyright">&#169; 2024 STUDYSYNC. DESIGNED FOR COMPUTER SCIENCE SCHOLARS.</p>
        </div>

    </div>

    <script>
        function togglePassword(inputId, btn) {
            const input = document.getElementById(inputId);
            input.type = input.type === 'password' ? 'text' : 'password';
        }
    </script>

</body>
</html>
