@page
@model StudySync.Pages.FlashcardsModel
@{
    ViewData["Title"] = "Flashcards";
}

@Html.AntiForgeryToken()

@section Styles {
    <link rel="stylesheet" href="~/css/flashcards.css" asp-append-version="true" />
}

<!-- Page heading -->
<div class="fc-heading">
    <div>
        <h1><i class="fa-solid fa-layer-group"></i> Flashcards</h1>
        <p>Create and study flashcard decks for your CS topics.</p>
    </div>
    <button class="btn-new-deck" onclick="toggleNewDeckForm()">
        <i class="fa-solid fa-plus"></i> New Deck
    </button>
</div>

<!-- New deck form -->
<div id="newDeckForm" class="new-deck-form hidden">
    <div class="deck-form-card">
        <h3><i class="fa-solid fa-layer-group"></i> Create New Deck</h3>
        <div class="deck-form-row">
            <div class="form-group">
                <label>DECK TITLE</label>
                <input type="text" id="newDeckTitle"
                        placeholder="e.g. Data Structures Revision" />
            </div>
            <div class="form-group">
                <label>TOPIC / CATEGORY</label>
                <input type="text" id="newDeckTopic"
                        placeholder="e.g. Algorithms" />
            </div>
        </div>
        <div class="deck-form-actions">
            <button class="btn-create-deck" onclick="createDeck()">
                <i class="fa-solid fa-plus"></i> Create Deck
            </button>
            <button class="btn-cancel-form" onclick="toggleNewDeckForm()">
                Cancel
            </button>
        </div>
    </div>
</div>

<!-- ── DECKS VIEW ── -->
<div id="decksView">

    <!-- Stats row -->
    <div class="fc-stats">
        <div class="fc-stat">
            <i class="fa-solid fa-layer-group"></i>
            <span><strong>@Model.TotalDecks</strong> Decks</span>
        </div>
        <div class="fc-stat">
            <i class="fa-solid fa-rectangle-list"></i>
            <span><strong>@Model.TotalCards</strong> Cards</span>
        </div>
        <div class="fc-stat">
            <i class="fa-solid fa-circle-check"></i>
            <span><strong>@Model.MasteredCards</strong> Mastered</span>
        </div>
    </div>

    @if (Model.Decks.Count == 0)
    {
        <div class="fc-empty">
            <i class="fa-solid fa-layer-group"></i>
            <h2>No Flashcard Decks Yet</h2>
            <p>Create your first deck to start studying smarter.</p>
            <button class="btn-new-deck" onclick="toggleNewDeckForm()">
                <i class="fa-solid fa-plus"></i> Create First Deck
            </button>
        </div>
    }
    else
    {
        <div class="deck-grid" id="deckGrid">
            @foreach (var deck in Model.Decks)
            {
                var progress = deck.CardCount > 0
                ? (deck.MasteredCount * 100 / deck.CardCount) : 0;

                <div class="deck-card" data-title="@deck.Title.ToLower()">
                    <div class="deck-card-top">
                        <div class="deck-icon-wrap">
                            <i class="fa-solid fa-layer-group"></i>
                        </div>
                        <button class="deck-delete-btn"
                                onclick="deleteDeck(@deck.DeckId, this)"
                                title="Delete deck">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                    <div class="deck-title">@deck.Title</div>
                    @if (!string.IsNullOrEmpty(deck.Topic))
                    {
                        <div class="deck-topic">
                            <i class="fa-solid fa-tag"></i> @deck.Topic
                        </div>
                    }
                    <div class="deck-meta">
                        <span>
                            <i class="fa-solid fa-rectangle-list"></i>
                            @deck.CardCount @(deck.CardCount == 1 ? "card" : "cards")
                        </span>
                        <span>
                            <i class="fa-solid fa-circle-check"></i>
                            @deck.MasteredCount mastered
                        </span>
                    </div>
                    <div class="deck-progress-bar">
                        <div class="deck-progress-fill"
                                style="width:@progress%"></div>
                    </div>
                    <div class="deck-progress-label">@progress% complete</div>
                    <div class="deck-actions">
                        <button class="btn-study"
                                onclick="openStudyMode(@deck.DeckId, '@Html.Raw(deck.Title.Replace("'", "\\'"))')">
                            <i class="fa-solid fa-graduation-cap"></i> Study
                        </button>
                        <button class="btn-add-card"
                                onclick="openAddCard(@deck.DeckId)">
                            <i class="fa-solid fa-plus"></i> Add Card
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- ── STUDY MODE ── -->
<div id="studyView" class="hidden">
    <div class="study-header">
        <button class="btn-back-decks" onclick="backToDecks()">
            <i class="fa-solid fa-arrow-left"></i> Back to Decks
        </button>
        <h2 id="studyDeckTitle"></h2>
        <div class="study-progress-badge">
            <span id="studyProgress">0 / 0</span>
        </div>
    </div>

    <!-- Flashcard -->
    <div class="flashcard-wrap" id="flashcardWrap">
        <div class="flashcard" id="flashcard" onclick="flipCard()">
            <div class="flashcard-inner" id="flashcardInner">
                <div class="flashcard-front">
                    <div class="card-side-label">
                        <i class="fa-solid fa-question-circle"></i> QUESTION
                    </div>
                    <div class="card-content" id="cardFront">
                        Loading...
                    </div>
                </div>
                <div class="flashcard-back">
                    <div class="card-side-label">
                        <i class="fa-solid fa-lightbulb"></i> ANSWER
                    </div>
                    <div class="card-content" id="cardBack"></div>
                </div>
            </div>
        </div>
        <p class="flip-hint">
            <i class="fa-solid fa-hand-pointer"></i> Click the card to reveal the answer
        </p>
    </div>

    <!-- Study controls -->
    <div class="study-controls hidden" id="studyControls">
        <button class="btn-wrong" onclick="markCard(false)">
            <i class="fa-solid fa-xmark"></i> Still Learning
        </button>
        <button class="btn-skip-card" onclick="nextCard()">
            <i class="fa-solid fa-forward"></i> Skip
        </button>
        <button class="btn-correct" onclick="markCard(true)">
            <i class="fa-solid fa-check"></i> Got It
        </button>
    </div>

    <!-- Completed state -->
    <div id="studyComplete" class="study-complete hidden">
        <i class="fa-solid fa-trophy"></i>
        <h2>Session Complete!</h2>
        <p id="studyResult"></p>
        <div class="complete-actions">
            <button class="btn-study" onclick="restartStudy()">
                <i class="fa-solid fa-rotate-right"></i> Study Again
            </button>
            <button class="btn-back-decks" onclick="backToDecks()">
                <i class="fa-solid fa-arrow-left"></i> Back to Decks
            </button>
        </div>
    </div>
</div>

<!-- ── ADD CARD MODAL ── -->
<div id="addCardModal" class="modal-overlay hidden">
    <div class="modal-card">
        <div class="modal-header">
            <h3><i class="fa-solid fa-plus"></i> Add Flashcard</h3>
            <button class="modal-close" onclick="closeAddCard()">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <input type="hidden" id="addCardDeckId" />
        <div class="form-group">
            <label>QUESTION / FRONT</label>
            <textarea id="cardQuestion" rows="3"
                        placeholder="e.g. What is a Binary Search Tree?"></textarea>
        </div>
        <div class="form-group">
            <label>ANSWER / BACK</label>
            <textarea id="cardAnswer" rows="3"
                        placeholder="e.g. A BST is a tree where left child &lt; parent &lt; right child"></textarea>
        </div>
        <div class="modal-actions">
            <button class="btn-create-deck" onclick="addCard()">
                <i class="fa-solid fa-plus"></i> Add Card
            </button>
            <button class="btn-cancel-form" onclick="closeAddCard()">Cancel</button>
        </div>
    </div>
</div>

<script>
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

    // ── Sidebar ───────────────────────────────────────────────────────────
    function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('sidebar-open');
    document.getElementById('sidebarOverlay').classList.toggle('hidden');
    }

    // ── New deck form ─────────────────────────────────────────────────────
    function toggleNewDeckForm() {
    document.getElementById('newDeckForm').classList.toggle('hidden');
    if (!document.getElementById('newDeckForm').classList.contains('hidden')) {
    document.getElementById('newDeckTitle').focus();
    }
    }

    // ── Create deck ───────────────────────────────────────────────────────
    async function createDeck() {
    const title = document.getElementById('newDeckTitle').value.trim();
    const topic = document.getElementById('newDeckTopic').value.trim();

    if (!title) { alert('Please enter a deck title.'); return; }

    const response = await fetch('/Flashcards?handler=CreateDeck', {
    method: 'POST',
    headers: {
    'Content-Type': 'application/json',
    'RequestVerificationToken': token
    },
    body: JSON.stringify({ title, topic })
    });

    if (response.ok) location.reload();
    else alert('Could not create deck. Please try again.');
    }

    // ── Delete deck ───────────────────────────────────────────────────────
    async function deleteDeck(deckId, btn) {
    if (!confirm('Delete this deck and all its cards? This cannot be undone.')) return;
    btn.disabled = true;

    const response = await fetch('/Flashcards?handler=DeleteDeck', {
    method: 'POST',
    headers: {
    'Content-Type': 'application/json',
    'RequestVerificationToken': token
    },
    body: JSON.stringify({ deckId })
    });

    if (response.ok) location.reload();
    else { btn.disabled = false; alert('Could not delete deck.'); }
    }

    // ── Add card modal ────────────────────────────────────────────────────
    function openAddCard(deckId) {
    document.getElementById('addCardDeckId').value = deckId;
    document.getElementById('cardQuestion').value  = '';
    document.getElementById('cardAnswer').value    = '';
    document.getElementById('addCardModal').classList.remove('hidden');
    document.getElementById('cardQuestion').focus();
    }

    function closeAddCard() {
    document.getElementById('addCardModal').classList.add('hidden');
    }

    async function addCard() {
    const deckId   = parseInt(document.getElementById('addCardDeckId').value);
    const question = document.getElementById('cardQuestion').value.trim();
    const answer   = document.getElementById('cardAnswer').value.trim();

    if (!question || !answer) {
    alert('Please fill in both the question and answer.');
    return;
    }

    const response = await fetch('/Flashcards?handler=AddCard', {
    method: 'POST',
    headers: {
    'Content-Type': 'application/json',
    'RequestVerificationToken': token
    },
    body: JSON.stringify({ deckId, question, answer })
    });

    if (response.ok) { closeAddCard(); location.reload(); }
    else alert('Could not add card. Please try again.');
    }

    // ── Study mode ────────────────────────────────────────────────────────
    let studyCards    = [];
    let currentIndex  = 0;
    let correctCount  = 0;
    let isFlipped     = false;

    async function openStudyMode(deckId, deckTitle) {
    correctCount = 0;
    currentIndex = 0;

    const response = await fetch(`/Flashcards?handler=GetCards&deckId=${deckId}`);
    if (!response.ok) { alert('Could not load cards.'); return; }

    studyCards = await response.json();

    if (studyCards.length === 0) {
    alert('This deck has no cards yet. Add some cards first!');
    return;
    }

    document.getElementById('decksView').classList.add('hidden');
    document.getElementById('studyView').classList.remove('hidden');
    document.getElementById('studyDeckTitle').textContent = deckTitle;
    document.getElementById('studyComplete').classList.add('hidden');
    document.getElementById('flashcardWrap').classList.remove('hidden');
    document.getElementById('studyControls').classList.add('hidden');

    showCard(0);
    }

    function showCard(index) {
    if (index >= studyCards.length) {
    showComplete();
    return;
    }

    isFlipped = false;
    const inner = document.getElementById('flashcardInner');
    inner.classList.remove('flipped');

    document.getElementById('cardFront').textContent = studyCards[index].question;
    document.getElementById('cardBack').textContent  = studyCards[index].answer;
    document.getElementById('studyProgress').textContent =
    `${index + 1} / ${studyCards.length}`;
    document.getElementById('studyControls').classList.add('hidden');
    }

    function flipCard() {
    isFlipped = !isFlipped;
    document.getElementById('flashcardInner').classList.toggle('flipped', isFlipped);
    if (isFlipped) {
    document.getElementById('studyControls').classList.remove('hidden');
    }
    }

    function nextCard() {
    currentIndex++;
    showCard(currentIndex);
    }

    async function markCard(correct) {
    if (correct) correctCount++;

    await fetch('/Flashcards?handler=MarkCard', {
    method: 'POST',
    headers: {
    'Content-Type': 'application/json',
    'RequestVerificationToken': token
    },
    body: JSON.stringify({
    cardId:   studyCards[currentIndex].cardId,
    mastered: correct
    })
    });

    nextCard();
    }

    function showComplete() {
    document.getElementById('flashcardWrap').classList.add('hidden');
    document.getElementById('studyControls').classList.add('hidden');
    document.getElementById('studyComplete').classList.remove('hidden');
    document.getElementById('studyResult').textContent =
    `You got ${correctCount} out of ${studyCards.length} correct!`;
    }

    function restartStudy() {
    correctCount = 0;
    currentIndex = 0;
    document.getElementById('studyComplete').classList.add('hidden');
    document.getElementById('flashcardWrap').classList.remove('hidden');
    showCard(0);
    }

    function backToDecks() {
    document.getElementById('studyView').classList.add('hidden');
    document.getElementById('decksView').classList.remove('hidden');
    }

    // ── Filter decks ──────────────────────────────────────────────────────
    function handleSearch(query) {
        const q = query.toLowerCase();
        document.querySelectorAll('.deck-card').forEach(card => {
            card.style.display = card.dataset.title.includes(q) ? '' : 'none';
        });
    }

    // ── Close modal on overlay click ──────────────────────────────────────
    document.getElementById('addCardModal').addEventListener('click', function (e) {
    if (e.target === this) closeAddCard();
    });


</script>

