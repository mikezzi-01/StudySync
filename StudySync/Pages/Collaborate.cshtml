@page "{partnershipId:int}"
@model StudySync.Pages.CollaborateModel
@{
    ViewData["Title"] = "Collaborate";
    var currentUserId = Model.CurrentUserId;
}
@section Styles {
    <link rel="stylesheet" href="~/css/collaborate.css" asp-append-version="true" />
}



<div class="collab-layout-override">

    @Html.AntiForgeryToken()

    @if (Model.Partnership == null)
    {
        <div class="collab-error">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <h2>Partnership Not Found</h2>
            <p>This collaboration space does not exist or you do not have access.</p>
            <a href="/Dashboard" class="btn-back-dash">Back to Dashboard</a>
        </div>
    }
    else
    {
        <!-- ── Partner list (left column) ── -->
        <aside class="partners-list">
            <div class="partners-heading">
                <h3>My Study Partners</h3>
                <span class="partners-count">@Model.AllPartnerships.Count ACTIVE</span>
            </div>

            @foreach (var p in Model.AllPartnerships)
            {
                <a href="/Collaborate/@p.PartnershipId"
                    class="partner-item @(p.PartnershipId == Model.PartnershipId ? "active-partner" : "")">
                    <div class="partner-av">@p.Initials</div>
                    <div class="partner-details">
                        <div class="partner-name">@p.FullName</div>
                        <div class="partner-preview">@p.LastMessage</div>
                    </div>
                    <div class="partner-score">@p.MatchScore%</div>
                </a>
            }
        </aside>

        <!-- ── Chat area (right column) ── -->
        <div class="chat-area">

            <!-- Chat header -->
            <div class="chat-header">
                <div class="chat-header-left">
                    <div class="chat-av">@Model.PartnerInitials</div>
                    <div>
                        <div class="chat-partner-name">@Model.PartnerName</div>
                        <div class="chat-status">
                            <span class="online-dot"></span> Active now &bull;
                            @Model.PartnerRole
                        </div>
                    </div>
                </div>
                <div class="chat-header-actions">
                    <a href="/Feedback/@Model.PartnershipId"
                        class="icon-btn" title="Leave feedback">
                        <i class="fa-solid fa-star"></i>
                    </a>
                </div>
            </div>

            <!-- Chat tabs -->
            <div class="chat-tabs">
                <button class="chat-tab active" onclick="switchChatTab('chat', this)">
                    <i class="fa-solid fa-message"></i> CHAT
                </button>
                <button class="chat-tab" onclick="switchChatTab('notes', this)">
                    <i class="fa-solid fa-note-sticky"></i> SHARED NOTES
                </button>
                <button class="chat-tab" onclick="switchChatTab('sessions', this)">
                    <i class="fa-solid fa-calendar"></i> SESSIONS
                </button>
            </div>

            <!-- ── CHAT TAB ── -->
            <div id="tab-chat" class="chat-tab-panel">

                <!-- Messages -->
                <div class="messages-area" id="messagesArea">
                    @if (Model.Messages.Count == 0)
                    {
                        <div class="no-messages">
                            <i class="fa-solid fa-comments"></i>
                            <p>No messages yet. Say hello to @Model.PartnerName!</p>
                        </div>
                    }
                    else
                    {
                        var lastDate = "";
                        foreach (var msg in Model.Messages)
                        {
                            var msgDate = msg.SentAt.ToString("dddd, MMM dd").ToUpper();
                            if (msgDate != lastDate)
                            {
                                lastDate = msgDate;
                                <div class="date-divider">@msgDate</div>
                            }

                            if (msg.IsFile)
                            {
                                <div class="message-bubble @(msg.IsOwn ? "own" : "theirs")"
                                     data-file-id="file-@msg.FileId">
                                    <div class="bubble-file">
                                        <i class="fa-solid fa-file"></i>
                                        <div class="file-info">
                                            <div class="file-name">@msg.Content</div>
                                            <div class="file-size">@msg.FileSize</div>
                                        </div>
                                        <a href="/Collaborate/@Model.PartnershipId?handler=DownloadFile&fileId=@msg.FileId"
                                           class="file-download" title="Download">
                                            <i class="fa-solid fa-download"></i>
                                        </a>
                                    </div>
                                    <div class="bubble-time">@msg.SentAt.ToString("hh:mm tt")</div>
                                </div>
                            }
                            else
                            {
                                <div class="message-bubble @(msg.IsOwn ? "own" : "theirs")"
                                     data-msg-id="msg-@msg.MessageId">
                                    <div class="bubble-content">@msg.Content</div>
                                    <div class="bubble-time">@msg.SentAt.ToString("hh:mm tt")</div>
                                </div>
                            }
                        }
                    }
                </div>

                <!-- Message input -->
                <div class="message-input-area">
                    <button class="input-icon-btn" title="Attach file"
                            onclick="document.getElementById('fileInput').click()">
                        <i class="fa-solid fa-plus"></i>
                    </button>
                    <input type="file" id="fileInput"
                           accept="image/*,.pdf,.doc,.docx,.txt,.py,.cs,.js,.zip"
                           style="display:none"
                           onchange="uploadFile(this)" />
                    <input type="text" id="messageInput"
                            placeholder="Message @Model.PartnerName..."
                            onkeydown="if(event.key==='Enter') sendMessage()" />
                    <button class="btn-send-msg" onclick="sendMessage()">
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </div>
            </div>

            <!-- ── SHARED NOTES TAB ── -->
            <div id="tab-notes" class="chat-tab-panel hidden">
                <div class="notes-area">
                    <div class="notes-header">
                        <h3>Shared Notes</h3>
                        <button class="btn-save-notes" onclick="saveNotes()">
                            <i class="fa-solid fa-floppy-disk"></i> Save
                        </button>
                    </div>
                    <textarea id="sharedNotes"
                            placeholder="Write shared notes here... Both partners can edit and view these notes."
                            rows="20">@Model.SharedNotes</textarea>
                </div>
            </div>

            <!-- ── SESSIONS TAB ── -->
            <div id="tab-sessions" class="chat-tab-panel hidden">
                <div class="sessions-area">
                    <div class="sessions-header">
                        <h3>Study Sessions</h3>
                        <button class="btn-new-session" onclick="toggleNewSession()">
                            <i class="fa-solid fa-plus"></i> Schedule Session
                        </button>
                    </div>

                    <!-- New session form -->
                    <div id="newSessionForm" class="new-session-form hidden">
                        <input type="text" id="sessionTitle"
                                placeholder="Session title e.g. Algorithms Deep Dive" />
                        <input type="datetime-local" id="sessionDate" />
                        <input type="number" id="sessionDuration"
                                placeholder="Duration (minutes)" min="15" max="240" />
                        <button class="btn-create-session" onclick="createSession()">
                            <i class="fa-solid fa-calendar-plus"></i> Create Session
                        </button>
                    </div>

                    @if (Model.Sessions.Count == 0)
                    {
                        <div class="no-sessions">
                            <i class="fa-solid fa-calendar-xmark"></i>
                            <p>No sessions scheduled yet.</p>
                        </div>
                    }
                    else
                    {
                        foreach (var session in Model.Sessions)
                        {
                            <div class="session-card">
                                <div class="session-date-box">
                                    <span class="session-month">@session.ScheduledAt.ToString("MMM").ToUpper()</span>
                                    <span class="session-day">@session.ScheduledAt.Day</span>
                                </div>
                                <div class="session-info">
                                    <div class="session-title">@session.Title</div>
                                    <div class="session-meta">
                                        @session.ScheduledAt.ToString("dddd • h:mm tt") —
                                        @((session.ScheduledAt.AddMinutes(session.DurationMinutes)).ToString("h:mm tt"))
                                    </div>
                                </div>
                                <span class="session-status @(session.ScheduledAt > DateTime.Now ? "upcoming" : "past")">
                                    @(session.ScheduledAt > DateTime.Now ? "Upcoming" : "Completed")
                                </span>
                            </div>
                        }
                    }
                </div>
            </div>

        </div>
    }

</div>
 

@section Scripts {
    <script>
        const partnershipId = @Model.PartnershipId;
        const currentUserId = @Model.CurrentUserId;
        const token = document.querySelector(
            'input[name="__RequestVerificationToken"]')?.value || '';

        // ── Scroll to bottom on load ──────────────────────────────────────────
        window.onload = function () {
            const area = document.getElementById('messagesArea');
            if (area) area.scrollTop = area.scrollHeight;
        };

        // ── Chat tab switching ────────────────────────────────────────────────
        function switchChatTab(name, btn) {
            document.querySelectorAll('.chat-tab-panel')
                    .forEach(p => p.classList.add('hidden'));
            document.querySelectorAll('.chat-tab')
                    .forEach(t => t.classList.remove('active'));
            document.getElementById('tab-' + name).classList.remove('hidden');
            btn.classList.add('active');
        }

        // ── Send text message ─────────────────────────────────────────────────
        async function sendMessage() {
            const input   = document.getElementById('messageInput');
            const content = input.value.trim();
            if (!content) return;
            input.value = '';

            const response = await fetch(
                `/Collaborate/${partnershipId}?handler=SendMessage`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ content })
            });

            if (!response.ok) {
                alert('Could not send message. Please try again.');
                input.value = content;
            }
            // Do NOT manually append — polling will pick it up immediately
        }

        // ── Upload file ───────────────────────────────────────────────────────
        async function uploadFile(input) {
            const file = input.files[0];
            if (!file) return;

            if (file.size > 10 * 1024 * 1024) {
                alert('File size must be under 10MB.');
                input.value = '';
                return;
            }

            const formData = new FormData();
            formData.append('file', file);

            const response = await fetch(
                `/Collaborate/${partnershipId}?handler=UploadFile`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token },
                body: formData
            });

            if (!response.ok) {
                alert('Upload failed. Please try again.');
            }
            // Polling will pick up the file automatically
            input.value = '';
        }

        // ── Polling ───────────────────────────────────────────────────────────
        // Track last known message and file IDs to avoid duplicates
        let knownMessageIds = new Set();
        let knownFileIds    = new Set();

        // Seed known IDs from what was server-rendered on page load
        document.querySelectorAll('.message-bubble[data-msg-id]').forEach(el => {
            knownMessageIds.add(el.dataset.msgId);
        });
        document.querySelectorAll('.message-bubble[data-file-id]').forEach(el => {
            knownFileIds.add(el.dataset.fileId);
        });

        async function pollMessages() {
            try {
                const response = await fetch(
                    `/Collaborate/${partnershipId}?handler=GetMessages`);
                if (!response.ok) return;

                const data = await response.json();
                const area = document.getElementById('messagesArea');
                const wasAtBottom =
                    area.scrollHeight - area.clientHeight <= area.scrollTop + 60;

                let hasNew = false;

                // Add new text messages
                data.messages.forEach(msg => {
                    const id = 'msg-' + msg.messageId;
                    if (knownMessageIds.has(id)) return;
                    knownMessageIds.add(id);
                    hasNew = true;

                    const bubble = document.createElement('div');
                    bubble.className =
                        `message-bubble ${msg.isOwn ? 'own' : 'theirs'}`;
                    bubble.dataset.msgId = id;
                    bubble.innerHTML = `
                        <div class="bubble-content">${escapeHtml(msg.content)}</div>
                        <div class="bubble-time">${msg.sentAt}</div>`;
                    area.appendChild(bubble);
                });

                // Add new file messages
                data.files.forEach(f => {
                    const id = 'file-' + f.fileId;
                    if (knownFileIds.has(id)) return;
                    knownFileIds.add(id);
                    hasNew = true;

                    const bubble = document.createElement('div');
                    bubble.className =
                        `message-bubble ${f.isOwn ? 'own' : 'theirs'}`;
                    bubble.dataset.fileId = id;
                    bubble.innerHTML = `
                        <div class="bubble-file">
                            <i class="fa-solid fa-file"></i>
                            <div class="file-info">
                                <div class="file-name">${escapeHtml(f.fileName)}</div>
                                <div class="file-size">${f.fileSize}</div>
                            </div>
                            <a href="/Collaborate/${partnershipId}?handler=DownloadFile&fileId=${f.fileId}"
                               class="file-download" title="Download">
                                <i class="fa-solid fa-download"></i>
                            </a>
                        </div>
                        <div class="bubble-time">${f.uploadedAt}</div>`;
                    area.appendChild(bubble);
                });

                if (hasNew && wasAtBottom)
                    area.scrollTop = area.scrollHeight;

            } catch (err) {
                // Silent fail
            }
        }

        // Start polling every 4 seconds
        setInterval(pollMessages, 4000);

        // ── Helpers ───────────────────────────────────────────────────────────
        function escapeHtml(text) {
            return text
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        function formatBytes(bytes) {
            if (bytes < 1024)    return bytes + ' B';
            if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
            return (bytes / 1048576).toFixed(1) + ' MB';
        }

        function toggleNewSession() {
            const form = document.getElementById('newSessionForm');
            form.classList.toggle('hidden');
        }
    </script>
}